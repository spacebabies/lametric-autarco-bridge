# =============================================================================
# LaMetric Autarco/Solis Bridge - Configuration
#
# Rename this file to 'lametric-autarco-bridge.env' before running.
# Do NOT commit the real env file.
# =============================================================================

# -----------------------------------------------------------------------------
# LaMetric Device Configuration
# -----------------------------------------------------------------------------

# Full HTTP Push URL from the LaMetric Time "My Data DIY" app.
LAMETRIC_URL=http://192.168.1.50:8080/api/v2/widget/update/com.lametric.diy.devwidget/your_secret_here

# Device API key from the LaMetric developer portal or mobile app.
LAMETRIC_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Solis/Ginlong Modbus RTU Configuration
# -----------------------------------------------------------------------------

# USB RS485 adapter device.
SOLIS_MODBUS_DEVICE=/dev/ttyUSB0

# Common Solis RTU default is 9600 8N1. Adjust if your inverter menu says otherwise.
SOLIS_MODBUS_BAUDRATE=9600

# Inverter Modbus address. Usually 1 unless changed in the inverter settings.
SOLIS_MODBUS_SLAVE_ID=1

# Realtime active power register.
#
# Common string inverter map:
#   Active Power: 3004, 3005
#
# Common hybrid inverter map:
#   Active Power: 33079, 33080
#
# Some tools use one-based "register numbers" and some use zero-based addresses.
# This project sends the value below directly as the Modbus address to pymodbus.
# If reads fail or values look shifted, try one lower: 3003 or 33078.
SOLIS_MODBUS_REGISTER=3004
SOLIS_MODBUS_REGISTER_COUNT=2

# Scaling multiplier after register decode. Use 0.1 if your map says 1 register unit = 0.1 W.
SOLIS_MODBUS_SCALE=1.0

# Register word order for multi-register integers: big or little.
SOLIS_MODBUS_BYTEORDER=big

# Whether the decoded integer is signed.
SOLIS_MODBUS_SIGNED=false

# Read cadence and serial timeout.
SOLIS_MODBUS_POLL_INTERVAL=1.0
SOLIS_MODBUS_TIMEOUT=2.0
